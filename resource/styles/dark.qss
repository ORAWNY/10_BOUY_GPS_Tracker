/* ===== Dark Theme ===== */
QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #e5e7eb;
    background: #0b1220;
}

QToolBar {
    background: #111827;
    border: 0px;
    spacing: 6px;
    padding: 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    padding: 6px 10px;
    border-radius: 8px;
}
QToolButton:hover {
    border: 1px solid #334155;
    background: #0f172a;
}

QPushButton {
    background: #0ea5e9;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
}
QPushButton:hover { background: #0284c7; }
QPushButton:pressed { background: #0369a1; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e5e7eb;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #0ea5e9;
}

/* Tables */
QTableView, QTableWidget {
    background: #111827;
    alternate-background-color: #0f172a;
    color: #e5e7eb;
    gridline-color: #334155;
    border: 1px solid #334155;
}

/* IMPORTANT: do NOT force QTableWidget::item color globally */

QHeaderView::section {
    background: #0f172a;
    color: #e5e7eb;
    border: 1px solid #334155;
    padding: 6px 8px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px;
    background: #111827;
}
QTabBar::tab {
    background: #0f172a;
    color: #e5e7eb;
    padding: 8px 14px;
    border: 1px solid #334155;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background: #111827;
}

QToolTip {
    color: #0b1220;
    background: #e5e7eb;
    border: 0px;
    padding: 6px 8px;
    border-radius: 6px;
}

/* Checkboxes & Radios */
QCheckBox, QRadioButton { padding: 3px; color: #e5e7eb; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 2px solid #4b5563;
    border-radius: 3px;
    background: #1f2937;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #38bdf8; background: #0c1a2e;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #0ea5e9;
    border: 2px solid #0284c7;
    image: url(__CHECK_ICON__);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #374151; background: #111827;
}

/* ─── CollapsibleSection ──────────────────────────────────────────────── */
QFrame#cs_hdr {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
}
QFrame#cs_hdr:hover { background: #273548; }
QFrame#cs_body {
    background: #111827;
    border: 1px solid #334155;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ─── ChartBoard ──────────────────────────────────────────────────────── */
QFrame#chart_board_bar {
    background: #111827;
    border-bottom: 1px solid #334155;
}
QFrame#chart_card {
    background: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
}
QFrame#card_hdr {
    background: #1e293b;
    border-bottom: 1px solid #334155;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QSplitter#chart_vsplit::handle { background: #334155; }
QSplitter#chart_vsplit::handle:hover { background: #64748b; }
QSplitter#chart_row::handle { background: #334155; border-radius: 3px; }
QSplitter#chart_row::handle:hover { background: #64748b; }
