/* ===== Light Theme ===== */
QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #1f2937;
    background: #f3f4f6;
}

QToolBar {
    background: #ffffff;
    border: 0px;
    spacing: 6px;
    padding: 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    padding: 6px 10px;
    border-radius: 8px;
}
QToolButton:hover {
    border: 1px solid #e5e7eb;
    background: #f3f4f6;
}

QPushButton {
    background: #0ea5e9;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
}
QPushButton:hover { background: #0284c7; }
QPushButton:pressed { background: #0369a1; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 10px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1px solid #0ea5e9;
}

/* Tables */
QTableView, QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    color: #111827;
    gridline-color: #e5e7eb;
    border: 1px solid #e5e7eb;
}

/* IMPORTANT: do NOT force item text color here.
   If you set QTableWidget::item { color: ... }, it will fight your timer cell styling. */

QHeaderView::section {
    background: #f8fafc;
    color: #111827;
    border: 1px solid #e5e7eb;
    padding: 6px 8px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 8px;
    background: #ffffff;
}
QTabBar::tab {
    background: #f3f4f6;
    color: #111827;
    padding: 8px 14px;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background: #ffffff;
}

QToolTip {
    color: #ffffff;
    background: #111827;
    border: 0px;
    padding: 6px 8px;
    border-radius: 6px;
}

/* Checkboxes & Radios */
QCheckBox, QRadioButton { padding: 3px; color: #374151; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 2px solid #9ca3af;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0ea5e9; background: #f0f9ff;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #0ea5e9;
    border: 2px solid #0284c7;
    image: url(__CHECK_ICON__);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #d1d5db; background: #f3f4f6;
}

/* ─── CollapsibleSection ──────────────────────────────────────────────── */
QFrame#cs_hdr {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}
QFrame#cs_hdr:hover { background: #e2e8f0; }
QFrame#cs_body {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ─── ChartBoard ──────────────────────────────────────────────────────── */
QFrame#chart_board_bar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
QFrame#chart_card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
QFrame#card_hdr_overlay {
    background: rgba(248, 250, 252, 0.92);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
}
QSplitter#chart_row::handle { background: #e2e8f0; border-radius: 3px; }
QSplitter#chart_row::handle:hover { background: #94a3b8; }
QFrame#row_resize_handle {
    background: #f8fafc;
    border-top: 2px solid #e2e8f0;
    border-radius: 0 0 6px 6px;
}
QFrame#row_resize_handle:hover { background: #e2e8f0; border-top-color: #94a3b8; }
